{
  "name": "@carbonplan/icons",
  "version": "2.0.0",
  "description": "icons for our websites",
  "main": "dst/index.js",
  "module": "dst/index.mjs",
  "types": "dst/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "watch": "tsup --watch",
    "clean": "rimraf dst",
    "format": "prettier --write README.md 'src/**/*.tsx' 'src/**/*.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbonplan/icons.git"
  },
  "keywords": [
    "icons"
  ],
  "author": "freeman-lab",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/carbonplan/icons/issues"
  },
  "files": [
    "dst"
  ],
  "homepage": "https://github.com/carbonplan/icons#readme",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "theme-ui": ">=0.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "prettier": "^2.2.1",
    "rimraf": "2.6.3",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  }
}
